# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Admin Telegram User IDs (comma-separated). Admins can run /users and /kick.
# Regular users do NOT need to be listed — anyone who /starts the bot gets
# their own fresh trading wallet automatically (no approval needed).
TELEGRAM_ALLOWED_USERS=123456789

# Predict.fun Configuration (BNB Chain - Chain ID 56)
PREDICTFUN_API_KEY=your_predictfun_api_key
# Legacy/optional: an extra owner wallet. Every Telegram user gets their own
# auto-generated wallet (data/accounts.json, AES-encrypted), so this is NOT
# needed for user trading.
# PREDICTFUN_PRIVATE_KEY=0x...
# Optional: Predict Account (smart wallet / deposit address). If set, auth+orders use Predict Account flow.
# PREDICTFUN_ACCOUNT=0xYourDepositAddress
PREDICTFUN_TESTNET=false # Set true for BNB Testnet (chain 97)
PREDICTFUN_SERIES_SLUG=btc-updown-5m # Active 5m BTC series

# Blockchain RPC
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org/
# Provider polling interval in ms (300 is fine only for a PRIVATE RPC endpoint)
RPC_POLLING_MS=1000

# Multi-user (per-user wallets, max 10 members — no approval flow)
# Anyone who /starts the bot gets their own fresh trading wallet instantly.
# TELEGRAM_ALLOWED_USERS users become admins (/users, /kick, /unban, /reset).
# MAX_USERS=10
# Invite-only mode: set a code and new members must send `/start <code>`.
# Leave empty for open join.
# JOIN_CODE=
# Wallet encryption key (AES-256-GCM). STRONGLY recommended: long random value.
# If unset, the bot generates data/master.key on first run — BACK THAT FILE UP.
# Losing it (or changing this value) makes every member private key unrecoverable.
# WALLET_MASTER_KEY=change_me_to_a_long_random_string
# Per-member daily loss cap (defaults to DAILY_LOSS_LIMIT_USDT)
# USER_DAILY_LOSS_LIMIT_USDT=25

# Price oracle — Chainlink BTC/USD feed read directly on-chain (free, no key).
# This is the feed Predict.fun 5m BTC markets settle against (community-verified).
# Binance spot stays as automatic fallback while the feed is cold.
# CHAINLINK_BTC_USD_FEED=0x264990fbd0A4796A3E3d8E37C4d5F87a3aCa5Ebf

# Trading Safeguards & Risk Controls
DRY_RUN=true # Set to false to place real on-chain orders
MAX_BET_USDT=50 # Maximum single bet amount allowed
DAILY_LOSS_LIMIT_USDT=150 # Circuit breaker daily loss limit
SLIPPAGE_BPS=100 # 100 bps = 1.0% max worse price on BUY limits
LOCK_GUARD_SECONDS=30 # Don't place bets if less than 30s remaining in round

# Auto-Redeem
AUTO_REDEEM=true # Automatically claim winning bets after round settlement

# Persistence
# DATA_DIR=./data # risk state, trade history, users.json, accounts.json, master.key
# Members' wallet keys live in accounts.json (encrypted). Back up the whole
# data/ folder + master key; anyone with both can drain every member wallet.
