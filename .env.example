# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALLOWED_USERS=123456789,987654321 # Whitelisted Telegram User IDs (leave empty to allow all)

# Predict.fun Configuration (BNB Chain - Chain ID 56)
PREDICTFUN_API_KEY=your_predictfun_api_key
PREDICTFUN_PRIVATE_KEY=0x... # EOA or Privy wallet private key used to sign
# Optional: Predict Account (smart wallet / deposit address). If set, auth+orders use Predict Account flow.
# PREDICTFUN_ACCOUNT=0xYourDepositAddress
PREDICTFUN_TESTNET=false # Set true for BNB Testnet (chain 97)
PREDICTFUN_SERIES_SLUG=btc-updown-5m # Active 5m BTC series

# Blockchain RPC
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org/
# Provider polling interval in ms (300 is fine only for a PRIVATE RPC endpoint)
RPC_POLLING_MS=1000

# Price oracle — Pyth Hermes (same oracle Predict.fun settles against).
# Pyth update endpoints now REQUIRE an API key (free from dashboard.pyth.network).
# Without a key the bot automatically uses Binance spot as its price source.
# PYTH_API_KEY=your_free_key_from_dashboard.pyth.network
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# PYTH_FEED_ID=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

# Trading Safeguards & Risk Controls
DRY_RUN=true # Set to false to place real on-chain orders
MAX_BET_USDT=50 # Maximum single bet amount allowed
DAILY_LOSS_LIMIT_USDT=150 # Circuit breaker daily loss limit
SLIPPAGE_BPS=100 # 100 bps = 1.0% max worse price on BUY limits
LOCK_GUARD_SECONDS=30 # Don't place bets if less than 30s remaining in round

# Auto-Redeem
AUTO_REDEEM=true # Automatically claim winning bets after round settlement

# Persistence
# DATA_DIR=./data # Where risk state / trade history / redeemed markers are stored
